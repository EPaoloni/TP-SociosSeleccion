@model List<Inscripcion>
@{
    ViewData["Title"] = "Mis partidos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mis partidos</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Partidos" asp-action="Index" class="btn btn-outline-secondary">Ver todos los partidos</a>
        <a asp-action="Create" class="btn btn-primary">+ Anotarme a un partido</a>
    </div>
</div>

<partial name="_InscripcionesSocio" model="Model" />
