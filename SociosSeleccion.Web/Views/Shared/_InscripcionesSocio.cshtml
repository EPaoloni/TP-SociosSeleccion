@model IEnumerable<Inscripcion>
@*
    PartialView: tabla con las inscripciones a partidos de un socio.
    La usan el detalle del socio (administrador) y "Mis partidos" (socio).
*@
@{
    var controladorCancelar = User.IsInRole(nameof(RolUsuario.Administrador)) ? "Inscripciones" : "MisPartidos";
}

@if (!Model.Any())
{
    <div class="alert alert-light border">Todavía no hay inscripciones a ningún partido.</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Partido</th>
                <th>Competición</th>
                <th>Sector</th>
                <th class="text-center">Entradas</th>
                <th>Inscripto el</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inscripcion in Model.OrderBy(i => i.Partido?.Fecha))
            {
                <tr>
                    <td>
                        <a asp-controller="Partidos" asp-action="Details" asp-route-id="@inscripcion.PartidoId">@inscripcion.Partido?.Descripcion</a>
                    </td>
                    <td>@inscripcion.Partido?.Competicion</td>
                    <td>@inscripcion.Sector.NombreVisible()</td>
                    <td class="text-center">@inscripcion.CantidadEntradas</td>
                    <td>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        @if (inscripcion.Partido?.Fecha > DateTime.Now)
                        {
                            <form asp-controller="@controladorCancelar" asp-action="Cancelar" method="post"
                                  onsubmit="return confirm('¿Cancelar esta inscripción?');">
                                <input type="hidden" name="id" value="@inscripcion.Id" />
                                <input type="hidden" name="socioId" value="@inscripcion.SocioId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
