<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Socios Selección Argentina</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-seleccion mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="sol">&#9728;</span> Socios Selección
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menu">
                        <ul class="navbar-nav me-auto">
                            @if (User.IsInRole(nameof(RolUsuario.Administrador)))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Socios" asp-action="Index">Socios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Inscripciones" asp-action="Index">Inscripciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Partidos" asp-action="Index">Partidos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="MisPartidos" asp-action="Index">Mis partidos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Partidos" asp-action="Index">Partidos</a></li>
                            }
                        </ul>
                        <span class="navbar-text me-3">
                            @User.FindFirst("NombreCompleto")?.Value
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container pb-5">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer text-muted py-3">
        <div class="container small">
            UNLaM - Programación Avanzada II - TP Principal &middot; @DateTime.Now.Year
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
